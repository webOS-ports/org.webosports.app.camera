{
    "appId": "org.webosports.app.camera",
    "type": "regular",
    "allowedNames": [
        "org.webosports.app.camera",
        "org.webosports.app.camera-*",
        "org.webosports.app.camera*"
    ],
    "permissions": [
        {
            "service": "org.webosports.app.camera",
            "outbound": ["*"]
        },
        {
            "service": "org.webosports.app.camera-*",
            "outbound": ["*"]
        },
        {
            "service": "org.webosports.app.camera*",
            "outbound": ["*"]
        }
    ],
    "trustLevel": "oem"
}
