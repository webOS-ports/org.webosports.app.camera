import QtQuick 2.6

/*
 * The colours of a webOS preferences scene: light where the camera is dark,
 * as in the phone app's preferences (org.webosports.app.phone UiTheme).
 */
QtObject {
    readonly property color backgroundColor: '#d8d8d8'
    readonly property color headerColor: '#e0e0e0'
    readonly property color footerColor: '#b1b1b1'
    readonly property color textColor: '#2a2a2a'
    readonly property color secondaryTextColor: '#5a5a5a'
    readonly property color groupLabelColor: '#ffffff'
    readonly property color rowDividerColor: '#00000040'
    readonly property color doneColor: '#62b246'
}
